<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.guardtalk.validator">

    <!-- QUERY_ALL_PACKAGES: required so PackageManager.getPackagesForUid()
         (UID -> package-name mapping in the process list readout) returns
         results for ALL packages on Android 11+ package-visibility filtering.
         Read-only enumeration; no write or launch capability over other apps. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- REAL_GET_TASKS (signature|privileged): REQUIRED for ActivityManager
         .getRunningAppProcesses() to return the FULL process list rather than
         just the caller's own processes. Verified in AOSP source:
         frameworks/base/services/core/java/com/android/server/am/ActivityManagerService
           .java:10212  getRunningAppProcesses() calls
                       mAtmInternal.isGetTasksAllowed(...) -> sets allUids
         frameworks/base/services/core/java/com/android/server/am/ProcessList
           .java:4353   getRunningAppProcessesLOSP() filters on allUids:
                       (!allUids && app.uid != callingUid) -> skip
         frameworks/base/services/core/java/com/android/server/wm/
           ActivityTaskManagerService.java:3629 isGetTasksAllowed() grants
           when REAL_GET_TASKS is held (signature|privileged).
         PACKAGE_USAGE_STATS is NOT in this code path (it gates
         UsageStatsManager, a separate API) and is therefore NOT requested. -->
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />

    <!-- ACCESS_NETWORK_STATE: required to read ConnectivityManager transport
         type and network capabilities for the connectivity readout (check 6).
         Read-only; does not grant any network configuration capability. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- F-REMEDIATE-B3-SENSORS: in-app camera/mic switches share Settings
         SensorPrivacy polarity via SensorToggleHelper. MANAGE to persist;
         OBSERVE to follow QS / Settings. Does not grant capture.
         Lockdown-when-locked still fail-closed (4-arg mustDenySensors). -->
    <uses-permission android:name="android.permission.MANAGE_SENSOR_PRIVACY" />
    <uses-permission android:name="android.permission.OBSERVE_SENSOR_PRIVACY" />

    <!-- Item 18: see HTMLViewer jpeg/png/webp VIEW even if package visibility
         filters QUERY_ALL_PACKAGES. Not a gallery query. -->
    <queries>
        <package android:name="com.android.htmlviewer" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/jpeg" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/png" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/webp" />
        </intent>
    </queries>

    <!-- android:enabled="true" is explicit. dumpsys package "enabled=0" is
         COMPONENT_ENABLED_STATE_DEFAULT (follow manifest), not pm-disabled.
         No overlay / pm disable of this package was found in-tree. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault.Settings"
        android:allowBackup="false"
        android:enabled="true"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".ValidatorActivity"
            android:exported="true"
            android:enabled="true"
            android:enableOnBackInvokedCallback="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FR-4 process-list viewer. NON-exported: only ValidatorActivity
             (the launcher entry point) can start it. No other app can invoke
             the enumeration; there is no service/receiver/provider IPC. -->
        <activity
            android:name=".ProcessListActivity"
            android:exported="false"
            android:enabled="true"
            android:enableOnBackInvokedCallback="true"
            android:label="@string/process_view_title"
            android:parentActivityName=".ValidatorActivity" />

        <!-- Item 18: grant-only sample PNG for HTMLViewer VIEW. Not exported. -->
        <provider
            android:name=".SampleImageProvider"
            android:authorities="com.guardtalk.validator.sampleimage"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
