package {
    default_applicable_licenses: ["vendor_guardtalk_face_app_license"],
}

license {
    name: "vendor_guardtalk_face_app_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["NOTICE"],
}

android_app {
    name: "GuardTalkFace",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "system_current",
    certificate: "platform",
    privileged: true,
    required: ["privapp_whitelist_com.guardtalk.face"],
    optimize: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp_whitelist_com.guardtalk.face",
    src: "privapp-permissions-com.guardtalk.face.xml",
    sub_dir: "permissions",
    filename_from_src: true,
}
