<?xml version="1.0" encoding="utf-8"?>
<!-- GuardTalk default workspace override — F-HOME-LAYOUT
     Overrides com.android.launcher3 R.xml.default_workspace_5x8.

     §9 Acceptance: first boot / factory reset → only GuardTalk icon(s)
     on the default home screen + hotseat. No other default favorites.
     §11: no pinned-but-missing icons (excised apps not referenced);
          launcher remains usable (GT Info pinned in hotseat).

     Pinned inventory (exhaustive):
       Hotseat screen 0: GT Info (com.guardtalk.validator/.ValidatorActivity)
       Workspace screen 0, x=0 y=0: Settings (com.android.settings/.Settings)

     Excised apps NOT pinned (T-RM-APPS dependency): Auditor,
     ExactCalculator, InfoApp, Messaging, Dialer, TrichromeChrome, AppStore.
-->
<favorites xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher3">

    <!-- Hotseat: GT Info (sole GuardTalk app; ensures non-empty usable home). -->
    <favorite
        launcher:container="-101"
        launcher:screen="0"
        launcher:x="0"
        launcher:y="0"
        launcher:packageName="com.guardtalk.validator"
        launcher:className="com.guardtalk.validator.ValidatorActivity" />

    <!-- Workspace screen 0: Settings (kept reachable from default home). -->
    <favorite
        launcher:screen="0"
        launcher:x="0"
        launcher:y="0"
        launcher:packageName="com.android.settings"
        launcher:className="com.android.settings.Settings" />

</favorites>
