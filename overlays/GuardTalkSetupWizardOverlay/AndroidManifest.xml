<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.guardtalk.overlay.setupwizard">
    <!--
      T-W2-I6-THEME — RRO on SetupWizard2. Static + priority 999 so the
      GuardTalk brand always wins over the wizard's defaults.

      PARTITION MATCH (T-HOME-ROOTCAUSE audit): SetupWizard2 is built
      system_ext_specific (lands in /system_ext/priv-app/). The overlay
      MUST also be system_ext_specific so OverlayManager honors it on
      Android 14+ (SDK 34+), which filters out cross-partition static RROs.

      TARGET PACKAGE: the actual SetupWizard2 package name on this OS is
      "app.grapheneos.setupwizard" (NOT the AOSP default
      "com.android.setupwizard"). The prior targetPackage was wrong, so the
      overlay could never apply. Verified via:
        aapt2 dump badging .../system_ext/priv-app/SetupWizard2/SetupWizard2.apk
    -->
    <overlay android:targetPackage="app.grapheneos.setupwizard" android:isStatic="true" android:priority="999"/>
</manifest>
