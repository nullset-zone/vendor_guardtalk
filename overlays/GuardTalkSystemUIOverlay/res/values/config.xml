    <!-- T-W2-I2-FP: fingerprint HAL excision grace layer for SystemUI.
         The HAL is dropped in feature-excised/fp-excised.mk. These overlay
         values ensure SystemUI never listens for or surfaces fingerprint UI
         even if a stale feature flag lingers. Face biometrics is intentionally
         NOT touched (out of scope for this increment). -->
    <!-- Empty list: no packages allowed to run fingerprint listening while
         occluding the lock screen. -->
    <string-array name="config_fingerprint_listen_on_occluding_activity_packages" translatable="false">
    </string-array>

    <!-- T-W2-I3-NFC: NFC HAL excision grace layer for SystemUI.
         The NFC HAL feature-permission prebuilts are dropped in
         feature-excised/nfc-excised.mk so hasSystemFeature(FEATURE_NFC)
         returns false; NfcTile.isAvailable() already short-circuits on the
         missing feature. Overlay strips `nfc` from QS stock/default lists so
         the tile is never considered for auto-add / restore-from-backup. -->

    <!-- T-BT-UI-SWEEP (FR-F §9): quick_settings_tiles_new_default with `bt`,
         `nfc`, and `hearing_devices` removed.
         Original (frameworks/base/packages/SystemUI/res/values/config.xml:109-111):
         internet,bt,dnd,airplane,flashlight,rotation,alarm,screenrecord,
         battery,mictoggle,cameratoggle,location,nfc
         `hearing_devices` is a Bluetooth-profile tile (HearingDevicesTile depends
         on LocalBluetoothManager / BluetoothAdapter; HearingDevicesChecker
         short-circuits to false when LocalBluetoothManager is null, which it is
         when FEATURE_BLUETOOTH is absent — see SettingsLibraryModule:41-44 and
         LocalBluetoothAdapter.getInstance():74-83). Stripping it from the QS
         lists is defence-in-depth so it never appears in the QS editor or
         default slot and no restore-from-backup path can re-instate it (§11). -->
    <!-- F-SEC-P3-QS-EDITOR: Mic / Camera / Battery Saver remain on default /
         new_default panels (product baseline). Auto-reboot MUST NOT appear here
         — catalog-only via quick_settings_tiles_stock. See QS_TILES_POLICY.md. -->
    <string name="quick_settings_tiles_new_default" translatable="false">
        internet,dnd,airplane,flashlight,rotation,alarm,screenrecord,battery,mictoggle,cameratoggle,location
    </string>

    <!-- T-BT-UI-SWEEP + T-SEC-P3-QS + F-SEC-P3-QS-EDITOR:
         Editor / catalog list (StockTilesRepository → EditTilesListInteractor).
         Phase-3 GuardTalk tiles grouped for discoverability in edit mode:
           battery (Battery Saver), mictoggle, cameratoggle, autoreboot
         `saver` remains Data Saver (AOSP) — distinct from Battery Saver `battery`.
         Forbidden tiles absent: lockdown, usb, wipe, duress.
         bt / nfc / hearing_devices stripped (BT/NFC excision). -->
    <string name="quick_settings_tiles_stock" translatable="false">
        internet,flashlight,dnd,modes_dnd,alarm,airplane,controls,wallet,rotation,battery,mictoggle,cameratoggle,autoreboot,batteryShare,cast,screenrecord,location,hotspot,inversion,saver,dark,work,night,reverse,reduce_brightness,qr_code_scanner,onehanded,color_correction,dream,font_scaling,record_issue,notes,desktopeffects
    </string>

    <!-- T-BT-QS-TILE / T-BT-UI-SWEEP: quick_settings_tiles_default with `bt`
         removed. F-SEC-P3-QS-EDITOR: no `autoreboot` on first-boot / reset panel. -->
    <string name="quick_settings_tiles_default" translatable="false">
        internet,flashlight,dnd,alarm,airplane,controls,wallet,rotation,battery,cast,screenrecord,mictoggle,cameratoggle,custom(com.android.permissioncontroller/.permission.service.v33.SafetyCenterQsTileService)
    </string>

    <!-- T-BT-UI-SWEEP (FR-F §9): status bar BT icon auto-hide documentation.
         No config boolean exists to override — verified: SystemUI does not gate
         the status bar BT connected icon on a config bool. PhoneStatusBarPolicy
         .updateBluetooth() (PhoneStatusBarPolicy.java:474-491) sets
         `bluetoothVisible = false` by default and only flips it true when
         mBluetooth.isBluetoothConnected() returns true. BluetoothControllerImpl
         .isBluetoothSupported() (BluetoothControllerImpl.java:233-235) returns
         `mLocalBluetoothManager != null`, and mLocalBluetoothManager is
         @Nullable-injected (SettingsLibraryModule.java:41-44) as the return of
         LocalBluetoothManager.create(), which returns null when
         BluetoothAdapter.getDefaultAdapter() returns null — the case once
         FEATURE_BLUETOOTH is excised. So isBluetoothConnected() short-circuits
         to false and the status bar BT icon is never made visible. The new
         Compose path (BluetoothIconViewModel.kt:49-54) is gated on
         interactor.isBluetoothConnected, which flows from
         BluetoothRepository.connectedDevices — empty when
         localBluetoothManager is null (BluetoothRepositoryImpl.kt:73,130,183).
         No overlay needed; this entry documents the contract (Law 8 / Law 19). -->

</resources>
