// PARTITION MATCH (T-HOME-ROOTCAUSE): Settings is system_ext_specific, so
// this overlay MUST be system_ext_specific to be honored by OverlayManager
// on Android 14+ (SDK 34+), which filters out cross-partition static RROs.
// CERTIFICATE FIX (T-HOME-ROOTCAUSE): Settings is signed with the platform
// certificate (privileged system app, no `certificate:` field in its Android.bp
// → Soong default = platform). On Android 12+ (SDK 31+), OverlayManager applies
// a static RRO that overrides NON-overlayable resources ONLY when the overlay
// is signed with the SAME certificate as its target. Settings bool/config
// resources (config_show_top_level_connected_devices, config_show_sim_info,
// etc.) are NOT declared `<overlayable>`, so a test-key static RRO is silently
// dropped at boot — the GuardTalk Settings-reduction + SIM/BT-hide overrides
// never apply. Signing with "platform" matches Settings' cert so OverlayManager
// enables it.
runtime_resource_overlay {
    name: "GuardTalkSettingsOverlay",
    sdk_version: "current",
    system_ext_specific: true,
    certificate: "platform",
}
