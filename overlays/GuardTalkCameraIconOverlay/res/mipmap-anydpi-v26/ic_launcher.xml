<?xml version="1.0" encoding="utf-8"?>
<!--
  GuardTalkOS themed adaptive launcher icon for app.grapheneos.camera.
  Overrides mipmap/ic_launcher (resource 0x7f0f0000, verified via aapt2).
  The stock Camera icon uses <adaptive-icon> referencing
  @color/ic_launcher_background + @drawable/ic_launcher_foreground; we replace
  the whole mipmap entry with our themed background + foreground drawables so
  the override wins regardless of the target's internal references.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
