protected long getChargingFunctions() {
            // GuardTalk fail-closed: true charging-only — never promote ADB/MTP while denied.
            if (mustDenyUsbData()) {
                return UsbManager.FUNCTION_NONE;
            }
            // if ADB is enabled, reset functions to ADB
